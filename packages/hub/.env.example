# ── PostgreSQL（docker compose 用）────────────────────────────
# docker-compose.yml がこの値で postgres コンテナを初期化する。必須（未設定だと docker compose up が失敗する）。
POSTGRES_USER=postgres
# 必須。ダミー値のまま運用しないこと。
# 生成例: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=dummy_password
POSTGRES_DB=mado_hub

# ── アプリケーション ──────────────────────────────────────────
# PostgreSQL接続文字列（ダミー値。実際の値は .env に設定する）
# docker compose 実行時は上記 POSTGRES_USER/PASSWORD/DB と同じ値に揃えること。
DATABASE_URL=postgresql://dummy_user:dummy_password@localhost:5432/mado_hub?schema=public

# カラム名設定ファイルのパス
# Docker環境では /data/columns.json がデフォルト
# ローカル開発時はプロジェクトルートの columns.json を指定
COLUMN_CONFIG_PATH=./columns.json

# セッションJWT署名用の秘密鍵（32文字以上のランダムな文字列を設定すること）
# 例の生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dummy-session-secret-please-replace-0000000000000000
